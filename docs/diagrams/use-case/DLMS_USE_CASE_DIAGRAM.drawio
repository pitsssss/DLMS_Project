<mxCell id="uc05_8" value="AI Assistant is an alternative assisted interaction channel for supported citizen operations.&lt;br/&gt;Mutating operations require citizen confirmation." style="shape=note;whiteSpace=wrap;html=1;size=16;fillColor=#FFFBEB;strokeColor=#B45309;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontFamily=Segoe UI;fontSize=11;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="80" y="420" width="430" height="88" as="geometry"/></mxCell>
<mxCell id="uc05_9" value="Files are never sent to Gemini." style="shape=note;whiteSpace=wrap;html=1;size=16;fillColor=#FFFBEB;strokeColor=#B45309;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontFamily=Segoe UI;fontSize=11;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="900" y="48" width="280" height="52" as="geometry"/></mxCell>
<mxCell id="uc05_10" value="&lt;b&gt;External integrations (reference — ovals live on UC-00)&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Mail / SMTP&lt;/b&gt;&lt;br/&gt;• Register and Activate Account&lt;br/&gt;• Recover Account Access&lt;br/&gt;• Authenticate to Employee Dashboard&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Payment Gateway&lt;/b&gt;&lt;br/&gt;• Pay Application Fees&lt;br/&gt;• Process Application Payments&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Firebase FCM&lt;/b&gt;&lt;br/&gt;• Register Mobile Device for Push / optional push delivery" style="shape=note;whiteSpace=wrap;html=1;size=16;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;fillColor=#FFFBEB;strokeColor=#B45309;fontFamily=Segoe UI;fontSize=11;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="80" y="530" width="700" height="280" as="geometry"/></mxCell>
<mxCell id="uc05_11" value="Database notifications are the source of truth; FCM is an optional delivery channel.&lt;br/&gt;Mock payment provider is internal and is not an actor." style="shape=note;whiteSpace=wrap;html=1;size=16;fillColor=#FFFBEB;strokeColor=#B45309;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontFamily=Segoe UI;fontSize=11;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="800" y="530" width="520" height="96" as="geometry"/></mxCell>
