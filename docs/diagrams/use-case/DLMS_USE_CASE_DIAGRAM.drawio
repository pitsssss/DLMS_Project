<mxCell id="uc00_134" value="AI Assistant is an alternative assisted interaction channel for supported citizen operations.&lt;br/&gt;Mutating operations require citizen confirmation." style="shape=note;whiteSpace=wrap;html=1;size=16;fillColor=#FFFBEB;strokeColor=#B45309;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontFamily=Segoe UI;fontSize=11;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="420" y="2940" width="420" height="88" as="geometry"/></mxCell>
<mxCell id="uc00_135" value="Admin and Super Admin may perform permission-gated employee operations through authorization bypass; specialized actors remain shown to represent separation of duties." style="shape=note;whiteSpace=wrap;html=1;size=16;fillColor=#FFFBEB;strokeColor=#B45309;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontFamily=Segoe UI;fontSize=11;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="1100" y="2940" width="520" height="88" as="geometry"/></mxCell>
<mxCell id="uc00_136" value="No «include» / «extend» relationships are used in this model.&lt;br/&gt;Process order is documented in Activity / Sequence Diagrams." style="shape=note;whiteSpace=wrap;html=1;size=16;fillColor=#FFFBEB;strokeColor=#B45309;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontFamily=Segoe UI;fontSize=11;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="1680" y="2940" width="420" height="88" as="geometry"/></mxCell>
<mxCell id="uc00_137" value="Specialized staff actors inherit from Employee; full hierarchy is shown in UC-OVERVIEW and UC-04." style="shape=note;whiteSpace=wrap;html=1;size=16;fillColor=#FFFBEB;strokeColor=#B45309;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontFamily=Segoe UI;fontSize=11;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="3580" y="3100" width="460" height="72" as="geometry"/></mxCell>
