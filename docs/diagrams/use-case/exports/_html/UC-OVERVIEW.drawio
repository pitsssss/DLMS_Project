<mxCell id="overview_34" value="AI Assistant is an alternative assisted interaction channel for supported citizen operations.&lt;br/&gt;Mutating operations require citizen confirmation." style="shape=note;whiteSpace=wrap;html=1;size=16;fillColor=#FFFBEB;strokeColor=#B45309;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontFamily=Segoe UI;fontSize=11;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="165" y="760" width="370" height="88" as="geometry"/></mxCell>
<mxCell id="overview_35" value="Admin and Super Admin may perform permission-gated employee operations through authorization bypass; specialized actors remain shown to represent separation of duties." style="shape=note;whiteSpace=wrap;html=1;size=16;fillColor=#FFFBEB;strokeColor=#B45309;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontFamily=Segoe UI;fontSize=11;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="545" y="760" width="370" height="88" as="geometry"/></mxCell>
<mxCell id="overview_36" value="Scheduled jobs and automatic notifications are internal and are not shown as Use Cases." style="text;html=1;align=left;fontFamily=Segoe UI;fontSize=11;fontColor=#64748B;" vertex="1" parent="1"><mxGeometry x="165" y="860" width="750" height="22" as="geometry"/></mxCell>
