{
  "info": {
    "name": "DLMS API — Phase 5 (+ Payments)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://127.0.0.1:8000/api" },
    { "key": "citizen_email", "value": "testcitizen@example.com" },
    { "key": "citizen_phone", "value": "0977000001" },
    { "key": "citizen_password", "value": "password123" },
    { "key": "otp_code", "value": "123456" },
    { "key": "citizen_token", "value": "" },
    { "key": "admin_email", "value": "admin@example.com" },
    { "key": "employee_email", "value": "employee@example.com" },
    { "key": "seed_password", "value": "password" },
    { "key": "admin_token", "value": "" },
    { "key": "employee_token", "value": "" },
    { "key": "reset_token", "value": "" },
    { "key": "new_password", "value": "newpassword123" },
    { "key": "license_type_id", "value": "1" },
    { "key": "service_type_id", "value": "1" },
    { "key": "application_id", "value": "" },
    { "key": "required_document_id", "value": "" },
    { "key": "pending_document_id", "value": "" },
    { "key": "payment_id", "value": "" },
    { "key": "checkout_url", "value": "" },
    { "key": "stripe_session_id", "value": "" }
  ],
  "item": [
    {
      "name": "1. Register Citizen By Email",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json", "type": "text" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Test Citizen\",\n  \"email\": \"{{citizen_email}}\",\n  \"phone\": \"{{citizen_phone}}\",\n  \"password\": \"{{citizen_password}}\",\n  \"password_confirmation\": \"{{citizen_password}}\"\n}"
        },
        "url": "{{base_url}}/auth/register"
      }
    },
    {
      "name": "2. Verify Email OTP",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json", "type": "text" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{citizen_email}}\",\n  \"code\": \"{{otp_code}}\",\n  \"purpose\": \"register\"\n}"
        },
        "url": "{{base_url}}/auth/verify-otp"
      }
    },
    {
      "name": "3. Login Citizen By Email",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "try {",
              "  var j = pm.response.json();",
              "  if (j.data && j.data.token) {",
              "    pm.collectionVariables.set('citizen_token', j.data.token);",
              "  }",
              "} catch (e) {}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json", "type": "text" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{citizen_email}}\",\n  \"password\": \"{{citizen_password}}\"\n}"
        },
        "url": "{{base_url}}/auth/login"
      }
    },
    {
      "name": "4. Get Me",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Accept", "value": "application/json", "type": "text" },
          { "key": "Authorization", "value": "Bearer {{citizen_token}}", "type": "text" }
        ],
        "url": "{{base_url}}/auth/me"
      }
    },
    {
      "name": "5. Complete Profile",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json", "type": "text" },
          { "key": "Authorization", "value": "Bearer {{citizen_token}}", "type": "text" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Test Citizen\",\n  \"national_id\": \"11001100110\",\n  \"birth_date\": \"1998-01-15\",\n  \"governorate\": \"Damascus\",\n  \"address\": \"Damascus - Syria\"\n}"
        },
        "url": "{{base_url}}/profile/complete"
      }
    },
    {
      "name": "6. Forgot Password By Email",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json", "type": "text" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{citizen_email}}\"\n}"
        },
        "url": "{{base_url}}/auth/forgot-password"
      }
    },
    {
      "name": "7. Verify Forgot Password OTP",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "try {",
              "  var j = pm.response.json();",
              "  if (j.data && j.data.reset_token) {",
              "    pm.collectionVariables.set('reset_token', j.data.reset_token);",
              "  }",
              "} catch (e) {}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json", "type": "text" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{citizen_email}}\",\n  \"code\": \"{{otp_code}}\"\n}"
        },
        "url": "{{base_url}}/auth/verify-forgot-password-otp"
      }
    },
    {
      "name": "8. Reset Password",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json", "type": "text" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{citizen_email}}\",\n  \"reset_token\": \"{{reset_token}}\",\n  \"password\": \"{{new_password}}\",\n  \"password_confirmation\": \"{{new_password}}\"\n}"
        },
        "url": "{{base_url}}/auth/reset-password"
      }
    },
    {
      "name": "9. Login With New Password",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json", "type": "text" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{citizen_email}}\",\n  \"password\": \"{{new_password}}\"\n}"
        },
        "url": "{{base_url}}/auth/login"
      }
    },
    {
      "name": "10. Login Admin",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json", "type": "text" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{admin_email}}\",\n  \"password\": \"{{seed_password}}\"\n}"
        },
        "url": "{{base_url}}/auth/login"
      }
    },
    {
      "name": "11. Login Employee",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "try {",
              "  var j = pm.response.json();",
              "  if (j.data && j.data.token) {",
              "    pm.collectionVariables.set('employee_token', j.data.token);",
              "  }",
              "} catch (e) {}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json", "type": "text" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{employee_email}}\",\n  \"password\": \"{{seed_password}}\"\n}"
        },
        "url": "{{base_url}}/auth/login"
      }
    },
    {
      "name": "12. List License Types (public)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "try {",
              "  var j = pm.response.json();",
              "  if (Array.isArray(j.data) && j.data.length && j.data[0].id) {",
              "    pm.collectionVariables.set('license_type_id', String(j.data[0].id));",
              "  }",
              "} catch (e) {}"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [{ "key": "Accept", "value": "application/json", "type": "text" }],
        "url": "{{base_url}}/license-types"
      }
    },
    {
      "name": "13. List Service Types (public)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "try {",
              "  var j = pm.response.json();",
              "  if (Array.isArray(j.data)) {",
              "    var row = j.data.find(function (d) { return d.code === 'new_license'; });",
              "    if (row && row.id) { pm.collectionVariables.set('service_type_id', String(row.id)); }",
              "    else if (j.data.length && j.data[0].id) { pm.collectionVariables.set('service_type_id', String(j.data[0].id)); }",
              "  }",
              "} catch (e) {}"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [{ "key": "Accept", "value": "application/json", "type": "text" }],
        "url": "{{base_url}}/service-types"
      }
    },
    {
      "name": "14. Create Application Draft (citizen)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "try {",
              "  var j = pm.response.json();",
              "  if (j.data && j.data.id) {",
              "    pm.collectionVariables.set('application_id', String(j.data.id));",
              "  }",
              "} catch (e) {}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json", "type": "text" },
          { "key": "Authorization", "value": "Bearer {{citizen_token}}", "type": "text" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"license_type_id\": {{license_type_id}},\n  \"service_type_id\": {{service_type_id}}\n}"
        },
        "url": "{{base_url}}/applications"
      }
    },
    {
      "name": "15. List My Applications",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Accept", "value": "application/json", "type": "text" },
          { "key": "Authorization", "value": "Bearer {{citizen_token}}", "type": "text" }
        ],
        "url": "{{base_url}}/applications?per_page=15"
      }
    },
    {
      "name": "16. Get Application By Id",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Accept", "value": "application/json", "type": "text" },
          { "key": "Authorization", "value": "Bearer {{citizen_token}}", "type": "text" }
        ],
        "url": "{{base_url}}/applications/{{application_id}}"
      }
    },
    {
      "name": "17. Required Documents Checklist",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "try {",
              "  var j = pm.response.json();",
              "  if (Array.isArray(j.data) && j.data.length && j.data[0].id) {",
              "    pm.collectionVariables.set('required_document_id', String(j.data[0].id));",
              "  }",
              "} catch (e) {}"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          { "key": "Accept", "value": "application/json", "type": "text" },
          { "key": "Authorization", "value": "Bearer {{citizen_token}}", "type": "text" }
        ],
        "url": "{{base_url}}/applications/{{application_id}}/required-documents"
      }
    },
    {
      "name": "18. Upload Application Document (multipart)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Accept", "value": "application/json", "type": "text" },
          { "key": "Authorization", "value": "Bearer {{citizen_token}}", "type": "text" }
        ],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "required_document_id",
              "value": "{{required_document_id}}",
              "type": "text"
            },
            {
              "key": "file",
              "type": "file",
              "src": "",
              "description": "Select a PDF or image (jpg/png) matching allowed_extensions for this document type."
            }
          ]
        },
        "url": "{{base_url}}/applications/{{application_id}}/documents"
      }
    },
    {
      "name": "19. Submit Documents For Review",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Accept", "value": "application/json", "type": "text" },
          { "key": "Authorization", "value": "Bearer {{citizen_token}}", "type": "text" }
        ],
        "url": "{{base_url}}/applications/{{application_id}}/submit-documents"
      }
    },
    {
      "name": "20. List Pending Documents (employee)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "try {",
              "  var j = pm.response.json();",
              "  if (j.data && j.data.items && j.data.items.length && j.data.items[0].id) {",
              "    pm.collectionVariables.set('pending_document_id', String(j.data.items[0].id));",
              "  }",
              "} catch (e) {}"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          { "key": "Accept", "value": "application/json", "type": "text" },
          { "key": "Authorization", "value": "Bearer {{employee_token}}", "type": "text" }
        ],
        "url": "{{base_url}}/admin/documents/pending-review?per_page=20"
      }
    },
    {
      "name": "21. Approve Document (employee)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Accept", "value": "application/json", "type": "text" },
          { "key": "Authorization", "value": "Bearer {{employee_token}}", "type": "text" }
        ],
        "url": "{{base_url}}/admin/documents/{{pending_document_id}}/approve"
      }
    },
    {
      "name": "22. Reject Document (employee)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json", "type": "text" },
          { "key": "Accept", "value": "application/json", "type": "text" },
          { "key": "Authorization", "value": "Bearer {{employee_token}}", "type": "text" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"rejection_reason\": \"Document is unclear. Please upload a higher resolution scan.\"\n}"
        },
        "url": "{{base_url}}/admin/documents/{{pending_document_id}}/reject"
      }
    },
    {
      "name": "23. Get Application Fee (citizen)",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Accept", "value": "application/json", "type": "text" },
          { "key": "Authorization", "value": "Bearer {{citizen_token}}", "type": "text" }
        ],
        "url": "{{base_url}}/applications/{{application_id}}/fee"
      }
    },
    {
      "name": "24. Create Application Payment (citizen)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "try {",
              "  var j = pm.response.json();",
              "  if (!j.data) return;",
              "  if (j.data.payment && j.data.payment.id) {",
              "    pm.collectionVariables.set('payment_id', String(j.data.payment.id));",
              "    if (j.data.checkout_url) pm.collectionVariables.set('checkout_url', String(j.data.checkout_url));",
              "    var pr = j.data.payment.provider_reference;",
              "    if (pr) pm.collectionVariables.set('stripe_session_id', String(pr));",
              "    var m = j.data.payment.metadata;",
              "    if (m && m.stripe_session_id) pm.collectionVariables.set('stripe_session_id', String(m.stripe_session_id));",
              "  } else if (j.data.id) {",
              "    pm.collectionVariables.set('payment_id', String(j.data.id));",
              "  }",
              "} catch (e) {}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json", "type": "text" },
          { "key": "Accept", "value": "application/json", "type": "text" },
          { "key": "Authorization", "value": "Bearer {{citizen_token}}", "type": "text" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{}"
        },
        "url": "{{base_url}}/applications/{{application_id}}/payments"
      }
    },
    {
      "name": "25. Check Payment Status (citizen)",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Accept", "value": "application/json", "type": "text" },
          { "key": "Authorization", "value": "Bearer {{citizen_token}}", "type": "text" }
        ],
        "url": "{{base_url}}/applications/{{application_id}}/payments/{{payment_id}}/status"
      }
    },
    {
      "name": "26. Confirm Application Payment (mock only)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Accept", "value": "application/json", "type": "text" },
          { "key": "Authorization", "value": "Bearer {{citizen_token}}", "type": "text" }
        ],
        "url": "{{base_url}}/applications/{{application_id}}/payments/{{payment_id}}/confirm"
      }
    },
    {
      "name": "27. List Application Payments (citizen)",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Accept", "value": "application/json", "type": "text" },
          { "key": "Authorization", "value": "Bearer {{citizen_token}}", "type": "text" }
        ],
        "url": "{{base_url}}/applications/{{application_id}}/payments"
      }
    }
  ]
}
