{
  "info": {
    "_postman_id": "f8d759bc-d545-4d0e-a2a7-87d6a4a8a390",
    "name": "DLMS Dashboard Citizen Applications",
    "description": "Postman collection to test listing all license applications for one dashboard citizen.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Dashboard Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Login succeeded', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "const json = pm.response.json();",
              "if (json && json.data && json.data.token) {",
              "  pm.collectionVariables.set('dashboard_token', json.data.token);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{dashboard_email}}\",\n  \"password\": \"{{dashboard_password}}\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/dashboard/auth/login",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "dashboard",
            "auth",
            "login"
          ]
        }
      },
      "response": []
    },
    {
      "name": "List Citizen Applications",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{dashboard_token}}",
              "type": "string"
            }
          ]
        },
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/dashboard/citizens/{{citizen_id}}/applications?per_page={{per_page}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "dashboard",
            "citizens",
            "{{citizen_id}}",
            "applications"
          ],
          "query": [
            {
              "key": "per_page",
              "value": "{{per_page}}"
            }
          ]
        }
      },
      "response": []
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000/api",
      "type": "string"
    },
    {
      "key": "dashboard_email",
      "value": "admin@example.com",
      "type": "string"
    },
    {
      "key": "dashboard_password",
      "value": "password",
      "type": "string"
    },
    {
      "key": "dashboard_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "citizen_id",
      "value": "1",
      "type": "string"
    },
    {
      "key": "per_page",
      "value": "20",
      "type": "string"
    }
  ]
}
