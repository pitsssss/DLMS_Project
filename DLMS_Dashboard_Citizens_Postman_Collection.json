            },
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/dashboard/citizens/profile-statuses",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "dashboard",
                "citizens",
                "profile-statuses"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Search Citizens",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{dashboard_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/dashboard/citizens/search?search_term={{citizen_search_term}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "dashboard",
                "citizens",
                "search"
              ],
              "query": [
                {
                  "key": "search_term",
                  "value": "{{citizen_search_term}}"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Create Citizen",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const stamp = Date.now();",
                  "pm.collectionVariables.set('new_citizen_email', `citizen.${stamp}@example.com`);",
                  "pm.collectionVariables.set('new_citizen_phone', `+9639${String(stamp).slice(-8)}`);",
                  "pm.collectionVariables.set('new_citizen_national_id', `NID${stamp}`);"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Citizen created', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "if (json && json.data && json.data.id) {",
                  "  pm.collectionVariables.set('citizen_id', json.data.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{dashboard_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Dashboard Test Citizen\",\n  \"email\": \"{{new_citizen_email}}\",\n  \"phone\": \"{{new_citizen_phone}}\",\n  \"national_id\": \"{{new_citizen_national_id}}\",\n  \"password\": \"password123\",\n  \"password_confirmation\": \"password123\",\n  \"birth_date\": \"1995-05-20\",\n  \"governorate\": \"Damascus\",\n  \"address\": \"Dashboard test address\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/dashboard/citizens",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "dashboard",
                "citizens"
              ]
            }
          },
          "response": []
        },
