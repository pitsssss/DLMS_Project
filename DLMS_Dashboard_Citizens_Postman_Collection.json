                }
              ]
            },
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/dashboard/citizens?per_page=20&is_active={{citizen_filter_is_active}}&profile_status={{citizen_filter_profile_status}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "dashboard",
                "citizens"
              ],
              "query": [
                {
                  "key": "per_page",
                  "value": "20"
                },
                {
                  "key": "is_active",
                  "value": "{{citizen_filter_is_active}}"
                },
                {
                  "key": "profile_status",
                  "value": "{{citizen_filter_profile_status}}"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Profile Status Options",
          "request": {
            "auth": {
              "type": "bearer",
