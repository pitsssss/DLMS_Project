{
  "info": {
    "_postman_id": "9b7f3180-57b9-4f35-a595-8f663c11f2c8",
    "name": "DLMS Dashboard Citizens",
    "description": "Focused collection for testing DashboardCitizenController routes. Run Dashboard Login first, then Create Citizen to populate citizen_id for show/update/delete.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Dashboard Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Login succeeded', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "if (json && json.data && json.data.token) {",
                  "  pm.collectionVariables.set('dashboard_token', json.data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{dashboard_email}}\",\n  \"password\": \"{{dashboard_password}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/dashboard/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "dashboard",
                "auth",
                "login"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Dashboard Me",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{dashboard_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/dashboard/auth/me",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "dashboard",
                "auth",
                "me"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Dashboard Citizens",
      "item": [
        {
          "name": "List Citizens",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{dashboard_token}}",
