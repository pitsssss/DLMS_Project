APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Hosted demo/QA only. Keep false on real production databases.
# When true, migrate:fresh --seed also runs DevelopmentDemoSeeder (demo users/data).
DEMO_SEEDING_ENABLED=false

APP_TIMEZONE=UTC
BUSINESS_TIMEZONE=Asia/Damascus

APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_SCHEME=tls
MAIL_FROM_ADDRESS=your-email@gmail.com
MAIL_FROM_NAME="DLMS"

# Brevo transactional email HTTPS API (OTP delivery — not SMTP)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=SYRTAK

# OTP (email delivery; set OTP_FIXED_CODE for local dev e.g. 123456)
OTP_EXPIRES_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_FIXED_CODE=
OTP_CHANNEL=email

PASSWORD_RESET_TOKEN_EXPIRES_MINUTES=15

# Payments: mock (local) or stripe (Stripe Checkout + webhooks)
PAYMENT_PROVIDER=stripe

# Canonical persisted currency for fines (uppercase machine code). Not client-selectable.
FINE_CURRENCY=USD

STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

STRIPE_CURRENCY=usd
# Application Stripe Checkout still uses these env URLs (Flutter/frontend or external pages).
# Fine Stripe Checkout uses internal Laravel routes /payment/success and /payment/cancel (APP_URL).
# Production: set APP_URL to the public HTTPS backend origin so Stripe can redirect citizens correctly.
STRIPE_SUCCESS_URL=
STRIPE_CANCEL_URL=

PAYMENT_STALE_PENDING_MINUTES=60
PAYMENT_RECONCILE_BATCH_SIZE=50

LICENSE_VALIDITY_YEARS=10
LICENSE_RENEWAL_GRACE_DAYS=90
# Public frontend page encoded in printed-license QR codes (not the Laravel API).
# Local default is fine for development. Production MUST point at the official
# SYRTAK verification frontend origin, e.g. https://syrtak.gov.sy/licenses/verify
# Do not leave this as localhost when printing real licenses.
LICENSE_VERIFICATION_PUBLIC_URL=http://localhost:3000/licenses/verify

# Employee Dashboard sessions (root Super Admin management)
EMPLOYEE_SESSION_ACTIVE_THRESHOLD_MINUTES=5
EMPLOYEE_SESSION_LAST_SEEN_WRITE_MINUTES=3
EMPLOYEE_SESSION_RETENTION_DAYS=180
EMPLOYEE_SESSION_HEARTBEAT_ENABLED=true
EMPLOYEE_SESSION_HEARTBEAT_MIN_SECONDS=30

# Behind Nginx / load balancer / ngrok, configure trusted proxies so Request::ip()
# reflects the real client. Prefer framework TrustProxies / at-proxy configuration
# rather than blindly trusting X-Forwarded-For from arbitrary clients.

AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_AGENT_ENABLED=true
AI_AGENT_REQUIRE_CONFIRMATION=true
AI_AGENT_MAX_HISTORY_MESSAGES=10
AI_AGENT_TEMPERATURE=0.2

# Firebase Cloud Messaging HTTP v1 (server transport — F2/F4)
# FIREBASE_CREDENTIALS_BASE64 = Base64 of service-account JSON (secret; encoding ≠ encryption)
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_BASE64=
# Optional absolute path to CA bundle when php.ini curl.cainfo is unset (Windows)
FIREBASE_CA_BUNDLE=
# Queued FCM delivery. Keep false until a push queue worker is running.
# Boolean via filter_var — string "false" is disabled.
FIREBASE_PUSH_ENABLED=false
# Production: FIREBASE_PUSH_ENABLED=true with QUEUE_CONNECTION=database and worker.
# Timeout chain: FCM 15s < FIREBASE_PUSH_JOB_TIMEOUT=60 < DB_QUEUE_RETRY_AFTER=120
DB_QUEUE_RETRY_AFTER=120
# FIREBASE_PUSH_TRIES=5
# FIREBASE_PUSH_JOB_MAX_TRIES=25
# FIREBASE_PUSH_JOB_TIMEOUT=60
# FIREBASE_PUSH_PROCESSING_LEASE=180
# FIREBASE_FCM_TIMEOUT_SECONDS=15
# FIREBASE_FCM_CONNECT_TIMEOUT_SECONDS=5

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
