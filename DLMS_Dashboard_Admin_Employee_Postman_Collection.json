    {
      "name": "01 - Dashboard Auth",
      "item": [
        {
          "name": "Dashboard login super admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{base_url}}/dashboard/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\"email\": \"{{super_admin_email}}\", \"password\": \"{{super_admin_password}}\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "try {",
                  "  var j = pm.response.json();",
                  "  if (j.data && j.data.token) pm.collectionVariables.set('super_admin_token', j.data.token);",
                  "} catch (e) {}"
                ]
              }
            }
          ]
        },
        {
          "name": "Dashboard me",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
