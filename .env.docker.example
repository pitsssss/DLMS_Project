APP_NAME=DLMS
APP_ENV=production
APP_DEBUG=false
APP_URL=https://your-ghaymah-domain.com

APP_KEY=

DB_CONNECTION=mysql
DB_HOST=your-ghaymah-managed-db-host
DB_PORT=3306
DB_DATABASE=your_ghaymah_database
DB_USERNAME=your_ghaymah_user
DB_PASSWORD=your_ghaymah_password

FILESYSTEM_DISK=public

MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="SYRTAK"

PAYMENT_PROVIDER=stripe

STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd
STRIPE_SUCCESS_URL=https://your-ghaymah-domain.com/payment/success?session_id={CHECKOUT_SESSION_ID}
STRIPE_CANCEL_URL=https://your-ghaymah-domain.com/payment/cancel

# Public frontend verification page encoded in printed-license QR codes.
# The API GET /api/licenses/verify/{token} stays on the Laravel host.
LICENSE_VERIFICATION_PUBLIC_URL=https://your-frontend-domain.com/licenses/verify

OTP_EXPIRES_MINUTES=10
OTP_FIXED_CODE=
OTP_CHANNEL=email

# Firebase Cloud Messaging HTTP v1 (server transport — F2/F4)
# FIREBASE_CREDENTIALS_BASE64 = Base64 of service-account JSON (secret)
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_BASE64=
FIREBASE_CA_BUNDLE=
FIREBASE_PUSH_ENABLED=false

# Production push (require worker): FIREBASE_PUSH_ENABLED=true + QUEUE_CONNECTION=database
# Timeouts: FCM 15s < job 60s < DB_QUEUE_RETRY_AFTER 120
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=120
# FIREBASE_PUSH_TRIES=5
# FIREBASE_PUSH_JOB_MAX_TRIES=25
# FIREBASE_PUSH_JOB_TIMEOUT=60
# FIREBASE_PUSH_PROCESSING_LEASE=180
# FIREBASE_FCM_TIMEOUT_SECONDS=15
# FIREBASE_FCM_CONNECT_TIMEOUT_SECONDS=5
